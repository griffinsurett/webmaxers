    "astro": "astro",
    "generate:icons": "node src/utils/icons/generate-icon-map.mjs",
    "sync:draco": "cp node_modules/three/examples/jsm/libs/draco/gltf/draco_wasm_wrapper.js node_modules/three/examples/jsm/libs/draco/gltf/draco_decoder.wasm public/draco/"
  },
