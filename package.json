    "@astrojs/vercel": "^11.0.11",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@formspree/react": "^3.0.0",
    "@freshjuice/zest": "2.7.0",
    "@iconify-json/fa6-solid": "^1.2.4",
    "@supabase/supabase-js": "^2.107.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.1.11",
    "@types/react-dom": "^19.1.7",
    "@types/three": "^0.184.1",
