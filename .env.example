# .env.example
# Duplicate this file as ".env" and fill in your actual credentials.
# Do NOT commit your ".env" file containing keys to git.

# ── Domain settings
PUBLIC_SITE_DOMAIN="webmaxxers.com"

# ── OpenAI Configuration (Required for chatbot completion & RAG embeddings)
OPENAI_API_KEY="your_openai_api_key_here"

# ── Supabase Configuration (Optional - for vector knowledge sync and chat logging)
SUPABASE_URL="https://your_project_id.supabase.co"
SUPABASE_ANON_KEY="your_supabase_anon_public_key_here"
# Service role key is required on the server to download/sync files from Supabase Storage buckets
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key_here"

# Formspree form IDs (the part after https://formspree.io/f/).
# PUBLIC_ so the client islands can read them; these are submit-only endpoints,
# not secrets. Only the winner form is listed here — the others predate this
# file and live in .env.
#
# Saucer Defender (/game) discount claims. Without it the claim form renders
# with its submit button disabled rather than silently failing on submit.
PUBLIC_FORMSPREE_WINNER_ID=""
