---
// src/integrations/partytown/PartytownLoader.astro
/**
 * Conditional Partytown Loader
 *
 * Only loads the Partytown bootstrap script if there are actual
 * scripts with type="text/partytown" on the page.
 *
 * This prevents loading ~3KB of unused JS when partytown isn't needed.
 *
 * Usage:
 *   <PartytownLoader forward={['dataLayer.push']} />
 */

export interface Props {
  /** Global variables to forward to partytown workers */
  forward?: string[];
  /** Enable debug mode */
  debug?: boolean;
}

const { forward = ['dataLayer.push'], debug = false } = Astro.props;

const forwardConfig = JSON.stringify(forward);
---

<script is:inline define:vars={{ forwardConfig, debug }}>
  // Conditional Partytown loader — only boots if partytown scripts exist.
  //
  // Consent interaction (this is load-bearing, do not simplify):
  // A tracker authored as `type="text/partytown"` is rewritten to
  // `type="text/plain"` by Zest's script blocker before this runs, so a naive
  // `querySelector('script[type="text/partytown"]')` finds nothing and the
  // worker never boots. Zest snapshots the original type and restores it when
  // consent is granted — at which point the tag is text/partytown again but
  // there is no worker to run it, and the tracker silently never fires.
  //
  // So we look for BOTH shapes, and boot again on zest:change.
  (function() {
    var booted = false;

    function hasPartytownScripts() {
      return !!document.querySelector(
        'script[type="text/partytown"],' +
        // Zest-blocked: type flipped to text/plain, category attribute added.
        // Only these two categories are ever routed through Partytown.
        'script[data-consent-category="analytics"],' +
        'script[data-consent-category="marketing"]'
      );
    }

    function boot() {
      if (booted) return;
      if (!hasPartytownScripts()) return;
      booted = true;

      var f = JSON.parse(forwardConfig);
      window.partytown = { lib: '/~partytown/', debug: debug, forward: f };

      var s = document.createElement('script');
      s.src = '/~partytown/partytown.js';
      document.head.appendChild(s);
    }

    boot();

    // Consent granted after load releases blocked scripts back to
    // text/partytown — make sure a worker exists to run them.
    window.addEventListener('zest:change', boot);
  })();
</script>
