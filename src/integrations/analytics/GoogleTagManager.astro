---
// src/integrations/analytics/GoogleTagManager.astro
/**
 * Google Tag Manager, gated by Zest.
 *
 * GDPR/CCPA compliance:
 * - Zest owns Consent Mode v2 (`consentModeGoogle: true` in consentConfig.ts).
 *   It pushes the denied `default` before any tracker can run, then pushes
 *   `update` on every consent change — so there is no hand-rolled gtag consent
 *   block here and no mapping table to drift out of sync with the banner.
 * - The GTM loader below stays inert until analytics consent is granted.
 * - No <noscript> tag: it would bypass consent entirely.
 *
 * The loader tag needs BOTH attributes and neither is redundant:
 *   - type="text/plain" stops the browser executing the inline script at parse
 *     time. Zest's blocker runs after parse, so it cannot un-run a script that
 *     has already executed.
 *   - data-consent-category tells Zest which category gates the replay. The
 *     attribute is `data-consent-category`, NOT `data-category` — the latter is
 *     silently ignored, leaving the tag permanently inert.
 *
 * GTM ID comes from the PUBLIC_GTM_ID environment variable.
 */

const GTM_ID = import.meta.env.PUBLIC_GTM_ID;
---

{GTM_ID && (
  <>
    {/* dataLayer + gtag shim. Zest pushes consent signals through these. */}
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      window.gtag = function gtag(){window.dataLayer.push(arguments);};
    </script>

    {/* GTM loader — inert until Zest replays it on analytics consent */}
    <script
      type="text/plain"
      data-consent-category="analytics"
      id="gtm-loader"
      is:inline
      set:html={`
        (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
        new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
        j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
        'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer','${GTM_ID}');
      `}
    />
  </>
)}
