---
/** Zest owns Consent Mode defaults and updates; this component only loads GTM.
 * Keep the existing Analytics gate. Tags inside the container must honor the
 * separate Advertising consent signals supplied by Zest.
 */
const GTM_ID = import.meta.env.PUBLIC_GTM_ID;
---

{GTM_ID && (
  <script is:inline define:vars={{ GTM_ID }}>
    (function () {
      if (window.__webmaxxersGtmBridge) return;
      window.__webmaxxersGtmBridge = true;
      window.dataLayer = window.dataLayer || [];
      window.gtag = window.gtag || function () { window.dataLayer.push(arguments); };
      let loaded = false;

      function loadWhenAllowed() {
        if (loaded || window.Zest?.getConsent()?.analytics !== true) return;
        loaded = true;
        // Zest has already queued defaults and restored/updated consent.
        window.dataLayer.push({ 'gtm.start': Date.now(), event: 'gtm.js' });
        const script = document.createElement('script');
        script.id = 'gtm-loader';
        // This bridge gates creation; avoid Zest queuing the same loader again.
        script.setAttribute('data-zest-allow', '');
        script.async = true;
        script.src = 'https://www.googletagmanager.com/gtm.js?id=' + encodeURIComponent(GTM_ID);
        document.head.appendChild(script);
      }

      document.addEventListener('zest:change', loadWhenAllowed);
      document.addEventListener('zest:ready', loadWhenAllowed);
      loadWhenAllowed();
    })();
  </script>
)}
