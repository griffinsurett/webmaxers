---
// src/components/HeroQuoteCard.astro
/**
 * Hero quote card — a short quote beside a portrait, sitting above the hero
 * stats. Modelled on the Hymanson Law hero's quote card (same two-pane layout:
 * quote left, portrait right), drawn in this site's card theme instead of
 * Hymanson's white glass: `card-bg` for the fill and border, plus a backdrop
 * blur so the 3D mark passing behind it does not fight the text.
 */
import { Image } from "astro:assets";
import defaultPortrait from "@/assets/me-on-computer-office.png";

export interface Props {
  quote?: string;
  attribution?: string;
  portrait?: ImageMetadata;
  portraitAlt?: string;
  className?: string;
}

const {
  quote = "You work with me, start to finish.",
  attribution = "Griffin, Founder",
  portrait = defaultPortrait,
  portraitAlt = "Griffin at his desk",
  className = "",
} = Astro.props;
---

<article class={`hero-quote-card card-bg backdrop-blur-md ${className}`.trim()}>
  <div class="hero-quote-card__quote-pane">
    <blockquote class="hero-quote-card__quote">“{quote}”</blockquote>
    <p class="hero-quote-card__attribution">— {attribution}</p>
  </div>
  <div class="hero-quote-card__portrait">
    <Image
      src={portrait}
      alt={portraitAlt}
      width={400}
      loading="lazy"
      class="hero-quote-card__portrait-image"
    />
  </div>
</article>

<style>
  .hero-quote-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 6.5rem;
    gap: 0.5rem;
    width: 100%;
    padding: 0.4rem;
    border-radius: 1rem;
  }

  .hero-quote-card__quote-pane {
    display: grid;
    align-content: center;
    gap: 0.5rem;
    padding: 0.6rem 0.8rem;
  }

  .hero-quote-card__quote {
    color: var(--color-heading);
    font-size: 1.15rem;
    font-weight: 300;
    line-height: 1.2;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .hero-quote-card__attribution {
    color: var(--color-text);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .hero-quote-card__portrait {
    height: 6.5rem;
    overflow: hidden;
    border-radius: 0.7rem;
  }

  /* Zoomed in on the face: the source is a wide office shot with the face
     small and centred at ~40% height, which read as a room, not a person.
     :global because the <img> is rendered by <Image>, a child component, and
     Astro's scoped styles do not reach into child components' markup — the
     plain selector silently matched nothing. */
  .hero-quote-card__portrait :global(.hero-quote-card__portrait-image) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.9);
    transform-origin: 50% 36%;
  }

  @media (min-width: 48rem) {
    .hero-quote-card {
      grid-template-columns: minmax(0, 1fr) 7.5rem;
      padding: 0.5rem;
    }

    .hero-quote-card__quote-pane {
      padding: 0.75rem 1rem;
    }

    .hero-quote-card__quote {
      font-size: 1.3rem;
    }

    .hero-quote-card__portrait {
      height: 7.5rem;
      border-radius: 0.75rem;
    }
  }
</style>
