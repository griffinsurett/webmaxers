---
// src/components/HeroQuoteCard.astro
/**
 * Hero card — a short line beside the founder's portrait, sitting above the
 * hero stats. Modelled on the Hymanson Law hero's quote card (same two-pane
 * layout: text left, portrait right), drawn in this site's card theme instead of
 * Hymanson's white glass: `card-bg` for the fill and border, plus a backdrop
 * blur so the 3D mark passing behind it does not fight the text.
 */
import { Image } from "astro:assets";
import defaultPortrait from "@/assets/me-on-computer-office.png";

export interface Props {
  /** The line itself. A statement, not a quote — no marks, no attribution. */
  text?: string;
  /** Optional supporting line under it. */
  body?: string;
  portrait?: ImageMetadata;
  portraitAlt?: string;
  className?: string;
}

const {
  text = "You deserve a website that's out of this world.",
  body,
  portrait = defaultPortrait,
  portraitAlt = "Griffin at his desk",
  className = "",
} = Astro.props;
---

<article class={`hero-quote-card card-bg backdrop-blur-md ${className}`.trim()}>
  <div class="hero-quote-card__quote-pane">
    <p class="hero-quote-card__quote">{text}</p>
    {body && <p class="hero-quote-card__body">{body}</p>}
  </div>
  <div class="hero-quote-card__portrait">
    <Image
      src={portrait}
      alt={portraitAlt}
      width={800}
      loading="lazy"
      class="hero-quote-card__portrait-image"
    />
  </div>
</article>

<style>
  /* Mobile: one column, photo on top. Side by side, the text column was only
     ~150px wide on a phone and wrapped the heading one or two words a line.
     md+: text left, photo right (below). */
  .hero-quote-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.5rem;
    width: 100%;
    padding: 0.5rem;
    border-radius: 1rem;
  }

  .hero-quote-card__quote-pane {
    display: grid;
    align-content: center;
    gap: 0.5rem;
    padding: 0.6rem 0.8rem;
  }

  .hero-quote-card__quote {
    color: var(--color-heading);
    font-size: 1.3rem;
    font-weight: 300;
    line-height: 1.2;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .hero-quote-card__body {
    color: var(--color-text);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .hero-quote-card__portrait {
    order: -1;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: 0.7rem;
  }

  /* Zoomed in on the founder: the source is a wide office shot with the face
     small and centred, which read as a room, not a person. Only enough zoom
     to fill the frame with head and shoulders — at 1.9x the top of the head
     was cropped off.
     :global because the <img> is rendered by <Image>, a child component, and
     Astro's scoped styles do not reach into child components' markup — the
     plain selector silently matched nothing. */
  .hero-quote-card__portrait :global(.hero-quote-card__portrait-image) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* The wide mobile frame shows the scene as shot; keep the head in it. */
    object-position: 50% 22%;
  }

  @media (min-width: 48rem) {
    .hero-quote-card {
      grid-template-columns: minmax(0, 1fr) 9.5rem;
      padding: 0.6rem;
    }

    .hero-quote-card__portrait :global(.hero-quote-card__portrait-image) {
      object-position: 50% 50%;
      transform: scale(1.25);
      transform-origin: 50% 12%;
    }

    .hero-quote-card__quote-pane {
      padding: 1rem 1.4rem;
    }

    .hero-quote-card__quote {
      font-size: 1.65rem;
    }

    .hero-quote-card__body {
      font-size: 0.95rem;
    }

    .hero-quote-card__portrait {
      order: 0;
      aspect-ratio: auto;
      height: 9.5rem;
      border-radius: 0.75rem;
    }
  }
</style>
