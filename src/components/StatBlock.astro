---
// src/components/StatBlock.astro
/**
 * StatBlock — the single reusable "number + label" unit shared by the hero
 * stat card and the testimonial counter. Number on top (animated count-up,
 * with optional inline icon + prefix/suffix), label beneath. One text format
 * everywhere: light weight (no bold), tight number→label spacing.
 */
import Counter from "@/components/Counter.astro";
import Icon from "@/components/Icon";
import type { IconType } from "@/content/schema";
import { iconGradient } from "@/utils/iconGradient";
import IconGradientDefs from "@/components/IconGradientDefs.astro";

interface Props {
  /** The number to count up to. */
  value: number;
  /** Label beneath the number. */
  label?: string;
  /** Optional icon shown inline to the left of the number. */
  icon?: IconType;
  prefix?: string;
  suffix?: string;
  decimals?: number;
  start?: number;
  duration?: number;
  /** Center (default) vs left-aligned content. */
  align?: "center" | "start";
  class?: string;
}

const {
  value,
  label,
  icon,
  prefix = "",
  suffix = "",
  decimals,
  start = 1,
  duration = 1600,
  align = "center",
  class: className = "",
} = Astro.props as Props;

const alignClass = align === "start" ? "items-start text-left" : "items-center text-center";

/** Primary-gradient icon paint. See @/utils/iconGradient for why SVG needs a
 *  <defs> + url(#id) reference rather than a CSS gradient. */
const iconGrad = iconGradient("stat", label ?? String(value));
---

<div class:list={["flex flex-col", alignClass, className]}>
  <span class="flex items-center gap-2 text-2xl lg:text-3xl font-light leading-none text-heading">
    {icon && (
      <span class="inline-flex shrink-0">
        <IconGradientDefs id={iconGrad.id} stops={iconGrad.stops} />
        <Icon icon={icon} size="md" style={iconGrad.style} />
      </span>
    )}
    <Counter
      start={start}
      end={value}
      duration={duration}
      prefix={prefix}
      suffix={suffix}
      decimals={decimals}
      class="leading-none"
    />
  </span>
  {/* `text-text`, not `text-muted`: muted is only 55% of --color-text, which read
      as washed-out gray on the stat's dark surface. The label names the number,
      so it's content rather than a hint. */}
  {label && (
    <span class="support-text text-text capitalize mt-0.5">{label}</span>
  )}
</div>
