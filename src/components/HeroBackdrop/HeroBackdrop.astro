---
// src/components/HeroBackdrop/HeroBackdrop.astro
/**
 * HeroBackdrop — the background layer for the hero → about stretch.
 *
 * DARK MODE ONLY: a star field — an instant CSS placeholder, then a
 * `client:idle` canvas crossfades in with twinkle + shooting stars. Light mode
 * gets nothing here and shows the normal page background.
 *
 * ── Scoping ────────────────────────────────────────────────────────────────
 * NONE, deliberately. This component just paints; it does not decide where it
 * starts or stops. Its parent (HomeTop) is a `position: sticky` box that spans
 * the hero → about region, so the backdrop is pinned to the viewport for
 * exactly as long as that region is on screen and is released at its edges.
 *
 * That replaces an earlier `endSelector` + IntersectionObserver, which watched
 * for an element inside About reaching the viewport top. It fired well BEFORE
 * the About photo had grown, so the backdrop vanished and left a stretch of
 * plain background behind a still-small photo. A component that has to guess
 * when to stop will guess wrong; giving it a container removes the guess.
 *
 * ── Reduced motion ─────────────────────────────────────────────────────────
 * The star field is hidden entirely: it is decorative, and the honest answer
 * under reduced motion is the plain page background, not a frozen field of
 * dots.
 */
import StarfieldCanvas from "@/components/Starfield/StarfieldCanvas.tsx";

interface Props {
  /** Extra classes for the root. Positioning comes from the parent container. */
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<div class:list={["backdrop-root", className]} data-hero-backdrop aria-hidden="true">
  {/* DARK: instant, no-JS star placeholder + the animated canvas over it. */}
  <div class="backdrop-stars">
    <div class="starfield-static"></div>
    <StarfieldCanvas client:idle />
  </div>

</div>


<style>
  /* POSITIONING IS THE CALLER'S. In the homepage hero this element carries
     `.home-top__pinned`, which makes it a sticky, viewport-tall layer bounded
     to the hero → about region.
     
     Deliberately no `position` here: an earlier version set `position:absolute`
     on this class, which silently beat `.home-top__pinned`'s `sticky` (equal
     specificity, and this component's styles come later), so the backdrop
     scrolled away with the hero instead of holding through About. A component
     that only paints should not also decide how it is positioned. */
  .backdrop-root {
    pointer-events: none;
    background: var(--color-bg);
    overflow: hidden;
  }

  /* ── Theme switching ─────────────────────────────────────────────────── */
  .backdrop-stars {
    position: absolute;
    inset: 0;
    display: none;
  }
  :global([data-theme="dark"]) .backdrop-stars {
    display: block;
  }

  /* Reduced motion: no star field at all — not a static one. Fires before
     hydration, so the placeholder never flashes in. The island independently
     keeps the canvas blank, which covers the live in-page toggle. The ROCK is
     deliberately left alone: it is a static image, not motion.

     These conditions mirror readMotionPreference() (see
     @/hooks/useMotionPreference) exactly, so the CSS and the island can never
     disagree about whether motion is reduced. */
  @media (prefers-reduced-motion: reduce) {
    .backdrop-stars {
      display: none !important;
    }
  }
  :global([data-a11y-motion="reduced"]) .backdrop-stars,
  :global([data-a11y-animations="true"]) .backdrop-stars,
  :global([data-a11y-images="hide"]) .backdrop-stars {
    display: none !important;
  }

  /* ── DARK: the star field ────────────────────────────────────────────── */
  .starfield-static,
  :global(.starfield-canvas) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  /* Pure-CSS static star field: layered radial-gradient "dots" tiled across the
     viewport. Calm, even, no animation — the instant placeholder. */
  .starfield-static {
    background-color: var(--color-bg);
    background-image:
      radial-gradient(1.2px 1.2px at 20% 30%, rgba(255, 255, 255, 0.85) 50%, transparent 52%),
      radial-gradient(1px 1px at 70% 20%, rgba(255, 255, 255, 0.7) 50%, transparent 52%),
      radial-gradient(1.4px 1.4px at 40% 70%, rgba(255, 255, 255, 0.8) 50%, transparent 52%),
      radial-gradient(1px 1px at 85% 60%, rgba(255, 255, 255, 0.6) 50%, transparent 52%),
      radial-gradient(1.1px 1.1px at 55% 45%, rgba(255, 255, 255, 0.75) 50%, transparent 52%),
      radial-gradient(0.9px 0.9px at 10% 80%, rgba(255, 255, 255, 0.6) 50%, transparent 52%),
      radial-gradient(1.3px 1.3px at 90% 90%, rgba(255, 255, 255, 0.7) 50%, transparent 52%),
      radial-gradient(1px 1px at 30% 15%, rgba(255, 255, 255, 0.65) 50%, transparent 52%);
    background-repeat: repeat;
    background-size: 320px 320px, 280px 280px, 360px 360px, 300px 300px,
      340px 340px, 260px 260px, 380px 380px, 290px 290px;
  }
</style>
