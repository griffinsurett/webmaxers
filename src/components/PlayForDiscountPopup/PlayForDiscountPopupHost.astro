---
// src/components/PlayForDiscountPopup/PlayForDiscountPopupHost.astro
/**
 * Server-side gate + content resolver for the timed promo popup.
 *
 * Mirrors i75's `SpecialCampaignPopupHost`: the .astro half reads the ACTIVE
 * PROMO from the `promos` content collection and decides whether to render at
 * all, so a disabled or missing promo ships no island and no JavaScript. The
 * React half only handles timing and presentation.
 *
 * Nothing about the offer is written here or in the component — copy, links and
 * per-campaign timing come from the promo entry (see src/utils/promos.ts for
 * the override-with-fallback chain). Swapping promos is a change to
 * `siteData.activePromoSlug`; adding one is a new .mdx file.
 *
 * ── Hydration ──────────────────────────────────────────────────────────────
 * `client:idle`, not `client:load`. The popup does not appear for 8 seconds, so
 * there is no reason for it to compete with the hero, the 3D mark or the
 * consent banner for main-thread time during load — which is the performance
 * requirement behind the delay in the first place.
 *
 * `client:idle` schedules hydration in a requestIdleCallback, so the island's
 * timer starts once the browser is quiet rather than on first paint. In
 * practice that is well inside the 8s window; the popup still lands on time,
 * but never at the cost of load. (`client:visible` would never fire — the
 * island renders no layout of its own until the modal opens.)
 */
import PlayForDiscountPopup from "./PlayForDiscountPopup";
import { popupData } from "@/content/siteData";
import { getActivePromoEntry, resolvePromoPopup, isExcludedPath } from "@/utils/promos";

const promo = resolvePromoPopup(await getActivePromoEntry());

// `excludePaths` comes from the promo itself (the game promo excludes /game —
// inviting someone to play a game they are already playing is nonsense, and the
// modal would cover the playfield). Keeping it in content means a future promo
// declares its own exclusions without touching this file.
const excluded = isExcludedPath(Astro.url.pathname, promo.excludePaths);

const shouldRender = popupData.enabled !== false && promo.enabled && !excluded;

/**
 * DEV ALWAYS SHOWS IT.
 *
 * In production the popup is once-per-browser (`frequencyMode: "campaign"`,
 * localStorage). That rule makes it effectively invisible while working on it:
 * you see it once, dismiss it, and every reload after that is a blank page
 * until you manually clear storage.
 *
 * So `import.meta.env.DEV` forces "always" — no persistence, opens on every
 * boot. This overrides ONLY the frequency; the delay and scroll trigger are
 * untouched, so what you see locally is still the real timing. The production
 * build takes the resolved promo's mode unchanged.
 */
const frequencyMode = import.meta.env.DEV ? "always" : promo.frequencyMode;
---

{
  shouldRender && (
    <PlayForDiscountPopup
      eyebrow={promo.eyebrow}
      heading={promo.heading}
      description={promo.description}
      buttonText={promo.buttonText}
      href={promo.href}
      secondaryButtonText={promo.secondaryButtonText}
      secondaryHref={promo.secondaryHref}
      secondaryExternal={promo.secondaryExternal}
      campaignSlug={promo.campaignSlug}
      delayMs={promo.delayMs}
      scrollPercent={promo.scrollPercent}
      frequencyMode={frequencyMode}
      storageKeyPrefix={promo.storageKeyPrefix}
      client:idle
    />
  )
}
