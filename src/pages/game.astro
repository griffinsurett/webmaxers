---
// src/pages/game.astro
/**
 * "Play for a discount" — Saucer Defender, full screen.
 *
 * ── Why this uses BaseLayout and not SiteLayout ────────────────────────────
 * Deliberately OUTSIDE the site chrome. The game is a fixed-size playfield with
 * its own HUD in all four corners, and the site's furniture fought it: the
 * fixed header (z-[100000]) sat over the score and clock, and the AskAi bar
 * floated across the middle of the playfield. Neither is dismissible mid-run.
 *
 * So: BaseLayout directly (no Header, no Footer — those live in SiteLayout),
 * and `noChat` to drop the AskAi bar. The consent banner is intentionally NOT
 * suppressed: it is outside the noChat gate in BaseLayout because consent is a
 * legal requirement, and it self-hides once answered.
 *
 * The game itself lives in `src/components/SpaceGame/` and is a vendored copy
 * of the standalone project at `applications/space-game`. Re-copy to update;
 * see that project's PORTING.md §9.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import SpaceGameSurface from "@/components/SpaceGame/SpaceGameSurface";
import "@/components/SpaceGame/rocket-loader.css";
import { siteData } from "@/content/siteData";
---

<BaseLayout
  title={`Play for a Discount | ${siteData.title}`}
  description="Beat Saucer Defender — score 10,000 points in 90 seconds — and claim a discount on your website project."
  noChat={true}
  showSkipLink={false}
  bodyClass="antialiased space-game-page"
  mainClass="h-dvh w-full"
  mainAriaLabel="Saucer Defender game"
>
  {/*
    Force dark mode for this route.

    The game is set in space and pins itself dark regardless, but the page
    around it would still render light for a visitor who has chosen light mode.
    Per the product decision this also WRITES the choice, so the site stays dark
    after visiting /game until the visitor changes it back.

    `is:inline` so it runs BEFORE paint — the same technique Theme.astro uses to
    prevent FOUC. Writing localStorage first means UseMode's initialiser reads
    "dark" and agrees with the DOM rather than fighting it on hydration.
  */}
  <script is:inline>
    (function () {
      try {
        localStorage.setItem("theme", "dark");
      } catch (_) {}
      var d = document.documentElement;
      d.setAttribute("data-theme", "dark");
      d.style.colorScheme = "dark";
    })();
  </script>

  <style is:global>
    /* The game owns the FIRST screenful; the discount terms sit one scroll
       below it. Vertical scrolling therefore has to stay available — an
       earlier version set `overflow: hidden` here, which made the terms
       unreachable. Horizontal scroll is still pinned, and `overscroll-behavior`
       stops iOS rubber-banding the page while dragging on the canvas. */
    body.space-game-page {
      margin: 0;
      overflow-x: hidden;
      overscroll-behavior-y: contain;
      background: var(--color-bg);
    }

    /* Fill the screen exactly, overriding the ported game.css's standalone
       caps (min(100dvh, 1000px) and a 1800px width cap, plus its rounded
       corners) — those are readability limits for a windowed page, and this
       page is not windowed. Applied from OUTSIDE the game so the vendored
       game.css stays a verbatim copy (PORTING.md §9). */
    .space-game-page .space-game {
      width: 100%;
      height: 100dvh;
      max-width: none;
      border-radius: 0;
    }
  </style>

  {/*
    ── The loader is STATIC MARKUP, not part of the island ──────────────────
    The rocket is rendered here, in Astro, so it is in the prerendered HTML and
    paints on the first frame. It deliberately does NOT live inside the React
    island: that island is `client:only`, so React has to download and hydrate
    before it can render anything at all — measured on a throttled connection,
    the loader never appeared, and the slower the network the longer the black
    screen before the thing whose whole job is covering the wait showed up.

    Static markup inverts that: the worse the connection, the more useful the
    loader is, which is the right way round. The island removes it once both
    clocks have landed (see SpaceGameSurface), by which point React is
    definitionally present.
  */}
  <div id="rocket-loader" class="rocket-loader" role="status" aria-live="polite" aria-label="Loading the game">
    {/* Starfield behind the rocket. Pure CSS, because Phaser — and therefore
        the game's own starfield — does not exist yet at loader time. */}
    <canvas class="rocket-loader__stars" aria-hidden="true"></canvas>
    <div class="rocket-loader__track">
      <div class="rocket-loader__rocket">
        <svg class="rocket-loader__svg" width="56" height="96" viewBox="0 0 56 96" fill="none" aria-hidden="true">
          <path d="M28 2c9 10 14 23 14 37v26H14V39C14 25 19 12 28 2z" fill="currentColor" />
          <path d="M14 45 4 66v10l10-8V45z" fill="currentColor" opacity="0.75" />
          <path d="M42 45l10 21v10l-10-8V45z" fill="currentColor" opacity="0.75" />
          <circle cx="28" cy="34" r="7" fill="#e0e7ff" />
          <circle cx="28" cy="34" r="4" fill="#0b1020" opacity="0.55" />
          <path d="M19 65h18v6H19z" fill="currentColor" opacity="0.6" />
        </svg>
        <span class="rocket-loader__flame" aria-hidden="true"></span>
      </div>
    </div>
    <p class="rocket-loader__caption" data-rocket-caption>Preparing for launch…</p>
  </div>

  {/*
    Reduced motion, decided before paint for the same reason the theme is.
    `readMotionPreference()` is a React hook module, so its logic is inlined
    here — the three attributes it checks plus the OS query. Keep in sync with
    src/hooks/useMotionPreference.ts.
  */}
  {/*
    Paint the loader's starfield.

    Inline and immediate: it has to be on screen before Phaser exists, which is
    the whole reason the loader has its own field at all. Randomly-placed points
    rather than a CSS pattern — layered tiled gradients were tried and repeat on
    a visible grid, which reads as a lattice, not a sky.

    Drift is delta-time scaled and each star WRAPS, so nothing accumulates
    without bound however long the loader is up (the same invariant the game
    itself follows — HANDOFF §4).
  */}
  <script is:inline>
    (function () {
      var canvas = document.querySelector(".rocket-loader__stars");
      if (!canvas) return;
      var ctx = canvas.getContext("2d");
      if (!ctx) return;

      var reduced =
        (window.matchMedia &&
          window.matchMedia("(prefers-reduced-motion: reduce)").matches) ||
        document.documentElement.getAttribute("data-a11y-motion") === "reduced" ||
        document.documentElement.getAttribute("data-a11y-animations") === "true";

      // Cap DPR at 2 — past that the cost climbs with no visible gain, the same
      // clamp StarfieldCanvas uses elsewhere on the site.
      var dpr = Math.min(window.devicePixelRatio || 1, 2);
      var w = 0, h = 0, stars = [];

      function seed() {
        w = canvas.clientWidth;
        h = canvas.clientHeight;
        canvas.width = Math.floor(w * dpr);
        canvas.height = Math.floor(h * dpr);
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        // Density scales with area so a phone is not as crowded as a desktop.
        var count = Math.round((w * h) / 5200);
        stars = [];
        for (var i = 0; i < count; i++) {
          var near = Math.random();
          stars.push({
            x: Math.random() * w,
            y: Math.random() * h,
            r: near > 0.92 ? 1.6 : near > 0.7 ? 1.1 : 0.7,
            a: 0.35 + Math.random() * 0.5,
            // Nearer stars drift faster: parallax.
            v: (near > 0.92 ? 26 : near > 0.7 ? 15 : 8)
          });
        }
      }

      function draw() {
        ctx.clearRect(0, 0, w, h);
        for (var i = 0; i < stars.length; i++) {
          var s = stars[i];
          ctx.globalAlpha = s.a;
          ctx.fillStyle = "#ffffff";
          ctx.beginPath();
          ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
          ctx.fill();
        }
        ctx.globalAlpha = 1;
      }

      seed();
      draw();

      if (!reduced) {
        var last = performance.now();
        var raf = function (now) {
          var dt = Math.min((now - last) / 1000, 0.05); // clamp tab-switch jumps
          last = now;
          for (var i = 0; i < stars.length; i++) {
            var s = stars[i];
            // Stars fall so the rocket reads as climbing. Wrapping keeps every
            // value bounded no matter how long this runs.
            s.y += s.v * dt;
            if (s.y > h + 2) { s.y = -2; s.x = Math.random() * w; }
          }
          draw();
          if (document.querySelector(".rocket-loader__stars")) {
            requestAnimationFrame(raf);
          }
        };
        requestAnimationFrame(raf);
      }

      var t;
      window.addEventListener("resize", function () {
        clearTimeout(t);
        t = setTimeout(function () { seed(); draw(); }, 150);
      }, { passive: true });
    })();
  </script>

  <script is:inline>
    (function () {
      var d = document.documentElement;
      var reduced =
        (window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches) ||
        d.getAttribute("data-a11y-motion") === "reduced" ||
        d.getAttribute("data-a11y-animations") === "true" ||
        d.getAttribute("data-a11y-images") === "hide";
      var el = document.getElementById("rocket-loader");
      if (el) el.setAttribute("data-reduced", reduced ? "true" : "false");
    })();
  </script>

  {/*
    `client:only="react"` rather than client:load.

    Phaser reads `window` at module scope, so any path that reaches it during
    Astro's prerender fails the build with "window is not defined". The
    component's types are already split into types.ts to keep them out of the
    SSR graph; client:only is the guarantee that this island never renders on
    the server at all.
  */}
  <SpaceGameSurface client:only="react" />
</BaseLayout>
