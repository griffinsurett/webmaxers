---
// src/pages/pricing.astro
import SiteLayout from "@/layouts/SiteLayout.astro";
import SecondaryHero from "@/layouts/heroes/SecondaryHero.astro";
import EyebrowSection from "@/layouts/EyebrowSection.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import CalculatorAgent from "@/components/CalculatorAgent/CalculatorAgent";
import Logo from "@/components/Logo/Logo.astro";
import PricingCalculatorLegacy from "@/components/PricingCalculatorLegacy/PricingCalculatorLegacy";
import { getCollection } from "astro:content";

// DEV ONLY — both calculators are gated behind two nested flags.
// `import.meta.env.DEV` is statically replaced at build time, so anything
// inside these blocks is stripped from production builds and never ships.
//
// showCalculators — outer gate, wraps BOTH calculators. Set to `true` to ship the current agent.
const showCalculators = true;
const showLegacyCalculator = import.meta.env.DEV;

// Feeds the legacy niche selector, the same way the old /pricing page did.
const industries = showLegacyCalculator
  ? await getCollection("industries", ({ data }) => !data.draft)
  : [];
const industryNames = industries
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0))
  .map((i) => i.data.title);

const heroHeading = {
  before: "Know what it costs",
  text: "before you ever get on a call.",
  after: "",
};

const heroDescription =
  "Answer a few questions about your business and our AI builds your site structure and a cost estimate on the spot — no back-and-forth, no pressure.";
---

<SiteLayout
  title="Pricing"
  description={heroDescription}
>
  <SecondaryHero
    id="pricing-hero"
    heading={heroHeading}
    description={heroDescription}
  />

  {/* OUTER GATE — wraps BOTH calculators. Flip `showCalculators` to ship the
      current agent; the legacy UI below stays gated by its own inner flag. */}
  {showCalculators && (
  <>
    <section id="calculator" class="outer-section">
      <div class="inner-section">
        <CalculatorAgent client:idle>
          {/* Static (non-Lottie) site logo, rendered by Astro and slotted into
              the agent's sidebar. */}
          <Logo
            slot="logo"
            useLottie={false}
            showText
            loading="lazy"
            class="pointer-events-none"
            titleFirstClass="text-3xl -ml-[0.1rem]"
            titleRestClass="text-xs p-0 m-0"
          />
        </CalculatorAgent>
      </div>
    </section>

    {/* INNER GATE — legacy calculator UI, restored from git (pre-f10e318a) for
        a visual side-by-side against the current agent above. Kept dev-only so
        it stays hidden even once the outer gate is opened. Its chat/repricing
        calls hit /api/estimate, which no longer exists, so those requests fail:
        the gate screen, two-pane layout, live site map panel and mobile price
        bar still render. */}
    {showLegacyCalculator && (
      <section id="calculator-legacy" class="outer-section section-rule-t">
        <div class="inner-section">
          <EyebrowSection eyebrow="Legacy UI — dev only">
            <SectionHeading
              heading={{
                before: "The previous",
                text: "calculator UI.",
              }}
              description="Restored from git for a side-by-side look. Conversational flow with a live, editable site map — its backend was removed, so the chat and repricing calls will error. This section does not ship to production."
            />
          </EyebrowSection>

          <div class="mt-12 lg:mt-16 rounded-2xl border border-border overflow-hidden">
            <PricingCalculatorLegacy client:only="react" industryNames={industryNames} />
          </div>
        </div>
      </section>
    )}
  </>
  )}
</SiteLayout>
