---
// src/layouts/sections/HomeCtaSection.astro
/** Closing CTA: hero-style copy and actions over a space backdrop. */
import Eyebrow from "@/components/Eyebrow";
import ContentRenderer from "@/components/ContentRenderer/ContentRenderer.astro";
import HeroActions from "@/components/HeroActions.astro";
import HeroLogo3D from "@/components/HeroLogo3D/HeroLogo3D.astro";
import { query, sortByOrder } from "@/utils/query";
import { contactCtaData } from "@/content/siteData";

interface Props {
  id?: string;
  eyebrow?: string;
  heading?: string;
  /** Description under the heading on the left. */
  text?: string;
  ctaText?: string;
  ctaLink?: string;
  ctaExternal?: boolean;
}

const {
  id = "home-cta",
  eyebrow = "Hey, I’m Griffin",
  heading = "I build websites that do the selling for you",
  text = "One team for design, development, and search — and the same person who built your site is the one who picks up when you need something changed.",
  ctaText = contactCtaData.text,
  ctaLink = contactCtaData.link,
  ctaExternal = contactCtaData.external ?? false,
} = Astro.props as Props;

---

<section id={id} class="home-cta section-rule-t section-container">
  <div class="home-cta__sky" aria-hidden="true"></div>
  <div class="home-cta__mark" aria-hidden="true">
    <HeroLogo3D variant="spin" class="absolute inset-0" />
  </div>

  <div class="home-cta__content">
    <div class="home-cta__copy">
      <Eyebrow>{eyebrow}</Eyebrow>
      <h2 class="heading-display home-cta__heading">{heading}</h2>
      <p class="text-base lg:text-lg leading-relaxed text-text max-w-xl">{text}</p>
      <HeroActions ctaText={ctaText} ctaLink={ctaLink} ctaExternal={ctaExternal} />
    </div>

    <div class="home-cta__proof">
      <ContentRenderer
        query={query("testimonials").where((entry) => entry.data.featured === true).limit(3)}
        variant="TestimonialCirclesCounterVariant"
        className="px-0 order-last md:order-none"
        id={`${id}-testimonial-circles`}
        counterStart={10}
        counterEnd={100}
        counterDuration={1800}
      />
      <ContentRenderer
        query={query("stats").orderBy(sortByOrder())}
        variant="AboutStatsVariant"
        showHeadingSection={false}
      />
    </div>
  </div>
</section>

<style>
  .home-cta {
    position: relative;
    isolation: isolate;
    overflow: clip;
    background: var(--color-bg);
    min-height: 75svh;
    display: flex;
    padding-block: clamp(3rem, 5vw, 5rem) 2rem;
  }
  .home-cta__content {
    position: relative;
    z-index: 1;
    width: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: clamp(2rem, 4vw, 4rem);
  }
  .home-cta__copy {
    max-width: min(60rem, 68%);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
  }
  .home-cta__heading {
    font-size: clamp(2.85rem, 5.5vw, 5.75rem);
    margin: 0;
  }
  .home-cta__proof {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 3rem;
  }
  .home-cta__mark {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  @media (max-width: 767px) {
    .home-cta { min-height: auto; padding-block: 4rem 3rem; }
    .home-cta__copy { max-width: 100%; }
    .home-cta__proof { flex-direction: column; align-items: flex-start; gap: 2rem; }
    .home-cta__content { gap: 4rem; }
  }
  .home-cta__sky {
    position: absolute;
    inset: 0;
    display: none;
    pointer-events: none;
  }
  :global([data-theme="dark"]) .home-cta__sky {
    display: block;
    background-image:
      radial-gradient(1.2px 1.2px at 20% 30%, #ffffffd9 50%, transparent 52%),
      radial-gradient(1px 1px at 70% 20%, #ffffffb3 50%, transparent 52%),
      radial-gradient(1.4px 1.4px at 40% 70%, #ffffffcc 50%, transparent 52%),
      radial-gradient(1px 1px at 85% 60%, #ffffff99 50%, transparent 52%),
      radial-gradient(1.1px 1.1px at 55% 45%, #ffffffbf 50%, transparent 52%),
      radial-gradient(0.9px 0.9px at 10% 80%, #ffffff99 50%, transparent 52%),
      radial-gradient(1.3px 1.3px at 90% 90%, #ffffffb3 50%, transparent 52%),
      radial-gradient(1px 1px at 30% 15%, #ffffffa6 50%, transparent 52%);
    background-size: 320px 320px, 280px 280px, 360px 360px, 300px 300px,
      340px 340px, 260px 260px, 380px 380px, 290px 290px;
  }
</style>
