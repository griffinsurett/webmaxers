---
// src/layouts/sections/ContactQuoteSection.astro
/**
 * ContactQuoteSection — the contact page's form section.
 *
 * Uses MediaCardSection (the founder-CTA layout): the same full-bleed founder
 * photo with a raised card over one side, except the card holds the form
 * instead of prose. Heading and copy sit above the fields inside the card.
 */
import MediaCardSection from "@/layouts/sections/MediaCardSection.astro";
import QuoteForm from "@/components/Form/forms/QuoteForm.astro";
import Eyebrow from "@/components/Eyebrow";
import founderImage from "@/assets/me-on-the-phone.png";

interface Props {
  id?: string;
  className?: string;
  eyebrowTitle?: string;
  showEyebrow?: boolean;
  heading?: string;
  description?: string;
  image?: ImageMetadata;
  formComponent?: any;
  formProps?: Record<string, any>;
}

const {
  id = "contact-quote",
  className = "",
  eyebrowTitle = "Request a Quote",
  showEyebrow = true,
  heading = "Tell us what you are planning and we will point you in the right direction.",
  description = "Whether you need a new website, a set of focused improvements, or ongoing support, this is the best place to start.",
  image = founderImage,
  formComponent: FormComponent = QuoteForm,
  formProps = {
    capabilityTitle: "Contact Us",
    capabilitySlug: "contact-us",
    serviceCategory: "contact-us",
    formType: "generic",
    buttonText: "Send quote request",
  },
} = Astro.props as Props;
---

{/* Keeps MediaCardSection's default card width so the photo's subject stays
    visible to the right of the card, exactly as on the founder CTA — the form's
    two-column field grid fits comfortably at that width. */}
<MediaCardSection id={id} image={image} className={className}>
  {showEyebrow && <Eyebrow>{eyebrowTitle}</Eyebrow>}

  <h2
    class:list={[
      "mb-0 text-[clamp(1.85rem,3.1vw,3rem)] font-light leading-[1.12] tracking-[-0.02em] text-heading text-balance",
      showEyebrow && "mt-4",
    ]}
  >
    {heading}
  </h2>

  <p class="mt-6 mb-0 text-[1.02rem] leading-[1.62] text-text/85">
    {description}
  </p>

  <div class="mt-8">
    <FormComponent {...formProps} />
  </div>
</MediaCardSection>
