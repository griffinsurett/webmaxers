---
// src/layouts/Footer.astro
/**
 * Footer — webmaxers-style layout with Webmaxxers text + button styles:
 *   Top   : eyebrow + large heading (left), CTA button (right).
 *   Lower : left  = copyright + "Ask AI about Us" prompt buttons.
 *           right = LEGAL column + SOCIAL icons.
 *   Base  : full-bleed logo + wordmark lockup, uncovered as the content above
 *           lifts off it (see RevealStack).
 */
import { siteData, ctaData } from "@/content/siteData";
import ContentRenderer from "@/components/ContentRenderer/ContentRenderer.astro";
import { query, sortByOrder } from "@/utils/query";
import { related } from "@/utils/query/snippets";
import CookiePreferencesButton from "@/integrations/preferences/consent/ui/CookiePreferencesButton";
import LanguageButton from "@/integrations/preferences/language/ui/LanguageButton";
import Button from "@/components/Button/Button";
import AIIconPrompt from "@/components/Footer/AIIconPrompt";
import Eyebrow from "@/components/Eyebrow";
import Logo from "@/components/Logo/Logo.astro";
import RevealStack from "@/components/StickyStack/RevealStack.astro";

const eyebrow = "Let's build work that inspires.";
const heading = "Ready to build";
const headingLine2 = "something bold?";

const aiFooterPrompt = `I'm researching ${siteData.title} for a potential website project.

Based on their website, give me a clear, decision-focused summary that covers:
- their strongest service and technical strengths
- what kinds of businesses they seem best suited for
- how they handle design, development, SEO/AEO, performance, maintenance, and long-term support
- what makes them a better option than a cheap template site, a solo freelancer, or a typical agency
- the key questions a business owner should ask before hiring them, and how well ${siteData.title} appears to answer those questions

Use this site as the source: ${siteData.url}

Keep it practical, specific, and favorable where the evidence supports it.`;

// LEGAL column heading styling (small uppercase muted label). The links + their
// hover behaviour live in FooterMenuVariant now.
const legalColClass = [
  "!py-0",
  "[&>div]:mb-4 [&_.h4]:text-sm [&_.h4]:font-light [&_.h4]:uppercase [&_.h4]:tracking-[0.24em] [&_.h4]:text-muted [&_.h4]:mb-0",
].join(" ");

---

<footer
  class="relative mt-auto"
  role="contentinfo"
  aria-label="Site footer"
>
  {/* Adobe-style reveal: the footer content is the `cover` that scrolls up and
      off; the giant wordmark is the `base` parked beneath, uncovered as the
      cover lifts away. The effect is confined to the footer (RevealStack clips
      its own overflow). */}
  <RevealStack>
  {/* The cover is split in two: this outer div paints the opaque background
      edge to edge (so it covers the wordmark across the full width, not just
      inside the container inset), while the inner one keeps the
      `inner-section` container and the content grid. */}
  <div slot="cover" class="footer-content">
  <div
    class="relative inner-section grid gap-x-12 gap-y-16 py-12 lg:grid-cols-2"
  >
    {/* Top-left — eyebrow + heading */}
    <div class="flex flex-col gap-3">
      <Eyebrow>{eyebrow}</Eyebrow>
      <h2 class="heading-display">
        {heading}<br />{headingLine2}
      </h2>
    </div>

    {/* Top-right — CTA (GWS button style), dropped to the bottom of its cell */}
    <div class="flex items-end justify-start lg:col-start-2 lg:row-start-1 lg:justify-end">
      <Button variant="primary" href={ctaData.link} client:visible>
        {ctaData.text}
      </Button>
    </div>

    {/* Lower-left — copyright + privacy control, then the Ask-AI prompt buttons */}
    <div class="flex flex-col gap-6 lg:col-start-1 lg:row-start-2">
      <div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-muted">
        <p class="m-0">
          &copy; {new Date().getFullYear()}
          {siteData.legalName}
        </p>
        {siteData.dbaNotice && (
          <p class="m-0 basis-full">{siteData.dbaNotice}</p>
        )}
        {/* Live here rather than inside the legal query, so that list stays a
            plain collection of pages. */}
        <CookiePreferencesButton client:visible />
        <LanguageButton client:visible />
      </div>
      <!-- <AIIconPrompt
        prompt={aiFooterPrompt}
        className="items-start text-left lg:flex-row lg:justify-start"
        listClassName="justify-start"
        client:visible
      /> -->
    </div>

    {/* Lower-right — NAVIGATE + LEGAL + SOCIAL, aligned under the CTA */}
    <div
      class="flex flex-wrap gap-x-16 gap-y-10 lg:col-start-2 lg:row-start-2 lg:justify-end"
    >
      <div class="flex flex-col gap-3">
        {/* Navigation links — the footer's OWN menu, so adding an item to the
            header's main-menu never silently changes the footer. Collection
            pages join it the same dynamic way they join the header, via
            `addToMenu` in their _meta.mdx. */}
        <ContentRenderer
          id="footer-nav-section"
          query={related("menu-items", "menu", "footer-menu").orderBy(sortByOrder())}
          variant="FooterMenuVariant"
          title="Navigate"
          showButtonSection={false}
          className={legalColClass}
        />
      </div>
      <div class="flex flex-col gap-3">
        {/* Legal links straight from the collection — a bare query, no synthetic
            cookie-preferences row (that now sits by the copyright). */}
        <ContentRenderer
          id="footer-legal-section"
          query={query("legal")}
          variant="FooterMenuVariant"
          title="Legal"
          showButtonSection={false}
          className={legalColClass}
        />
      </div>
      <div>
        <p class="footer-col__heading">Social</p>
        <ContentRenderer
          id="footer-social-section"
          query={query("social-media")}
          variant="SocialMediaBareVariant"
          size="lg"
          alignment="left"
        />
      </div>
    </div>
  </div>
  </div>

  {/* Full-bleed logo + wordmark lockup — the RevealStack `base`, parked at the
      footer's bottom and uncovered as the content above lifts off. Spans the
      viewport, clipped at both edges. Desktop/tablet only (hidden on mobile).
      The mark reuses the header's scroll-driven animated logo. */}
  <div slot="base" class="footer-wordmark" aria-hidden="true">
    {/* The same <Logo> lockup the header uses — mark plus the wordmark text
        the component already renders from
        siteData. Only the scale differs: the mark box comes from
        `logoMediaClass`, and the two text lines from the component's own
        `titleFirstClass` / `titleRestClass`, so the lockup's proportions and
        wrapping stay exactly as the component defines them. */}
    <Logo
      trigger="scroll"
      loading="lazy"
      altContext="Footer"
      logoMediaClass="footer-wordmark__mark block object-contain"
      logoWidths={[160, 240, 320]}
      logoSizes="(min-width: 1024px) 14vw, 18vw"
      titleFirstClass="footer-wordmark__line-lg text-heading -ml-[0.1rem] leading-wide no-translate"
      titleRestClass="footer-wordmark__line-sm font-light emphasized-text pt-2 uppercase whitespace-nowrap p-0 m-0 tracking-[0.2em]"
    />
  </div>
  </RevealStack>

  {/* Bottom legal bar + preference controls — commented out for now. */}
  {/* <div class="border-t border-border-soft">
    <div
      class="inner-section flex flex-col gap-4 py-8 text-text text-sm sm:flex-row sm:items-center sm:justify-between"
      role="region"
      aria-label="Legal notice and preference controls"
    >
      <p class="text-center sm:text-left">
        &copy; {new Date().getFullYear()}
        {siteData.legalName}. All rights reserved.
      </p>
      <PreferencesLayout showHeading={false} layout="horizontal" class="w-full sm:w-auto" />
    </div>
  </div> */}
</footer>

<style>
  /* The reveal mechanic (clip/sticky/stacking) lives in <RevealStack>. Here we
     only style the footer's own content + wordmark lockup. */

  /* One continuous background across the whole footer — the same flat --color-bg
     the body paints, so the footer reads as one surface with no seam against the
     page above it or between its own parts. (Was a fixed bg3→bg gradient,
     dropped along with the body's: `background-attachment: fixed` repaints on
     every scroll frame, and a flat colour matches by definition.) */
  footer {
    background-color: var(--color-bg);
  }

  /* The RevealStack `cover` has to be OPAQUE so the wordmark stays hidden until
     it is revealed. The same flat colour as the footer behind it covers the
     lockup completely while staying visually indistinguishable. */
  .footer-content {
    background-color: var(--color-bg);
  }

  /* Full-bleed logo + wordmark lockup (the RevealStack `base`): sized to span
     the viewport, clipped flush to the bottom edge so it bleeds off the
     left/right margins. Shown at every width. */
  .footer-wordmark {
      /* Scaled-up version of the header lockup, sized so the whole lockup spans
         the viewport edge to edge WITHOUT overflowing it. The mark and both text
         lines key off vw so they grow together and keep the header's proportions
         — the small line stays ~22% of the large one, as in the header's
         1.8rem / 0.66rem pairing.

         The type size is derived, not hand-picked: the lockup is
         `mark + gap + text`, so the text can only take the width the mark and
         gap leave behind. `--footer-mark` and `--footer-gap` are the inputs;
         `--footer-type-lg` divides the remaining width by the wordmark's
         width-to-font-size ratio (`--footer-type-ratio`), measured from the
         rendered face. That keeps the lockup flush to both edges for ANY title
         length — a longer name shrinks the type instead of overflowing the
         clip. Re-measure the ratio only if the title or header font changes. */
      --footer-mark: 14vw;
      --footer-gap: 3.25vw;
      /* Rendered width of the wordmark ÷ its font-size, for the current title
         in TikTok Sans (measured: 1869px wide at 295.2px = 6.33). */
      --footer-type-ratio: 6.33;
      /* 98vw not 100vw: leaves a hair of side breathing room and absorbs
         sub-pixel rounding so the lockup never re-triggers the clip. */
      --footer-type-lg: calc(
        (98vw - var(--footer-mark) - var(--footer-gap)) / var(--footer-type-ratio)
      );
      --footer-type-sm: calc(var(--footer-type-lg) * 0.223);

      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      width: 100%;
      /* The wordmark is the page's closing baseline, so it sits ON the bottom
         edge: no bottom padding. The `line-height: 0.78` on the large line
         already pulls the box tight around the letters, leaving ~4px under
         them at 1440 — enough that descenders clear the `overflow: hidden`
         without the glyphs floating above the edge.

         All the breathing room goes on top, where it separates the lockup from
         the footer content lifting off it. Measured: this is the gap that read
         as "too much Y spacing" — it was above the wordmark, not below. */
      padding-top: clamp(0.75rem, 1.5vw, 1.5rem);
      padding-bottom: 0;
      pointer-events: none;
  }

  /* Scale the gap between mark and text with the lockup. The lockup keeps its
     horizontal mark-beside-text arrangement at every width — only the scale
     changes. */
  .footer-wordmark :global(a) {
    gap: var(--footer-gap);
  }

  /* The lockup's sizes are set here rather than as arbitrary Tailwind values
     on the class props: those class strings are assembled inside a component
     prop, which Tailwind's scanner never sees, so `text-[var(--…)]` would
     never be generated. `:global` is required because these elements are
     rendered by <Logo>, not by this file. */
  .footer-wordmark :global(.footer-wordmark__mark) {
    width: var(--footer-mark);
    height: var(--footer-mark);
  }

  /* TextLogoStatic sets `style="line-height: normal"` inline on both lines.
     At header sizes that leading is invisible, but at ~275px it leaves ~83px
     of empty space inside the large line's box, reading as a gap between the
     two lines. `!important` is what it takes to beat the inline style, and
     this is scoped to the footer so the header lockup is unaffected. */
  .footer-wordmark :global(.footer-wordmark__line-lg) {
    font-size: var(--footer-type-lg);
    line-height: 0.78 !important;
  }

  .footer-wordmark :global(.footer-wordmark__line-sm) {
    font-size: var(--footer-type-sm);
    line-height: 1 !important;
  }

  .footer-col__heading {
    margin-bottom: 1rem;
    font-size: 0.875rem;
    font-weight: 300;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    /* --color-muted is 5.15:1 on the flat footer bg — clears WCAG AA (4.5:1) at
       this size/weight, so the muted hierarchy is kept. (Only muted OVER the
       About photo, e.g. .stat-label, had to switch to solid text.) */
    color: var(--color-muted);
  }
  /* Social glyph styling now lives in SocialMediaBareVariant — no overrides needed. */
</style>
