---
// src/layouts/Header.astro
/**
 * Site Header with Navigation
 */
import ContentRenderer from "@/components/ContentRenderer/ContentRenderer.astro";
import Logo from "@/components/Logo/Logo.astro";
import ThemeControls from "@/components/ThemeControls/ThemeControls.jsx";
import Button from "@/components/Button/Button";
import ScrollFadeOut from "@/components/ScrollFadeOut.astro";
import { related } from "@/utils/query/snippets";
---
<header
  class="site-header fixed w-full top-0 z-[100000]"
  data-site-header
  role="banner"
  aria-label="Primary site header"
>
  <div class="grid grid-cols-[minmax(0,1fr)_auto_auto] items-center head-foot-section py-2 gap-2 sm:gap-4">
    <div class="justify-self-start min-w-0 overflow-hidden">
      {/* The mark and wordmark both step down on small screens: at 390px the
          header also carries the theme gear, the Ask-AI pill and the hamburger,
          and at full size the lockup crowded them out. */}
      <Logo
        loading="eager"
        trigger="scroll"
        animateOutText={true}
        altContext="Home"
        logoMediaClass="block w-[30px] h-[30px] sm:w-[38px] sm:h-[38px] lg:w-[45px] lg:h-[45px] object-contain animate-spin-once"
        logoWidths={[30, 45, 60, 90]}
        logoSizes="(min-width: 1024px) 45px, (min-width: 640px) 38px, 30px"
        titleFirstClass="text-[1.15rem] sm:text-2xl lg:text-3xl text-heading -ml-[0.1rem] leading-wide no-translate"
        titleRestClass="font-light emphasized-text uppercase whitespace-nowrap text-[0.55rem] sm:text-xs lg:text-sm p-0 m-0 tracking-[0.12em] sm:tracking-[0.2em]"
      />
    </div>

    <ThemeControls client:idle />

    <div class="justify-self-end shrink-0">
      <nav
        class="flex items-center justify-center gap-2 sm:gap-4"
        aria-label="Primary navigation"
        role="navigation"
      >
        {/* Ask-AI trigger — opens the same modal as the floating ask bar that
            appears further down the page, via the ASK_AI_OPEN_EVENT the AskAi
            island already listens for. Wrapped in <ScrollFadeOut> so it recedes
            on scroll in step with the logo wordmark (which uses the same
            component) and returns on the way back up. */}
        <ScrollFadeOut>
          <Button
            id="header-ask-ai"
            type="button"
            variant="pillOutline"
            client:idle
          >
            Ask AI
          </Button>
        </ScrollFadeOut>

        <ContentRenderer
          query={related("menu-items", "menu", "main-menu")}
          variant="MenuVariant"
          mode="hamburger-only"
          className="header-navigation"
          hamburgerTransform={true}
          closeButton={false}
        />
      </nav>
    </div>
  </div>
</header>

<script is:inline>
  // Open the Ask-AI modal from the header trigger. Delegated off the document so
  // it works no matter when the Button island hydrates, and survives view
  // transitions. "ask-ai:open" is the literal ASK_AI_OPEN_EVENT string that the
  // AskAi island listens for — kept inline so this script doesn't pull the React
  // component into the header's bundle.
  document.addEventListener("click", (e) => {
    const target = e.target;
    if (target && target.closest && target.closest("#header-ask-ai")) {
      e.preventDefault();
      window.dispatchEvent(new Event("ask-ai:open"));
    }
  });
</script>

<script is:inline>
  (() => {
    const selector = "[data-site-header]";

    const setHeaderHeight = () => {
      const header = document.querySelector(selector);
      if (!header) return;

      const height = Math.ceil(header.getBoundingClientRect().height);
      document.documentElement.style.setProperty("--site-header-height", `${height}px`);
    };

    const init = () => {
      const header = document.querySelector(selector);
      if (!header) return;

      setHeaderHeight();

      if ("ResizeObserver" in window) {
        const observer = new ResizeObserver(setHeaderHeight);
        observer.observe(header);
      }

      window.addEventListener("resize", setHeaderHeight, { passive: true });
      window.addEventListener("load", setHeaderHeight, { once: true });
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", init, { once: true });
    } else {
      init();
    }
  })();
</script>
