---
// src/layouts/SEO.astro
/**
 * SEO Component - Meta Tag Generator
 *
 * Comprehensive SEO meta tag generation for all pages.
 * Handles:
 * - Basic meta tags (title, description)
 * - Open Graph tags (Facebook, LinkedIn)
 * - Twitter Card tags
 * - JSON-LD structured data (Schema.org)
 * - Canonical URLs
 * - Author and publisher information
 *
 * Uses fallback chain: SEO overrides → Base props → Site defaults
 * Generates absolute URLs for social sharing.
 *
 * During static builds, writes a per-page manifest entry to dist/__seo/
 * consumed by the robots-llms integration to generate robots.txt and llms.txt.
 */

import { writeFileSync, mkdirSync } from 'node:fs';
import { join } from 'node:path';
import { siteData } from "@/content/siteData";
// Webmaxxers-branded lockup (mark + wordmark on the dark brand background),
// captured from the site's own footer lockup so it stays in sync with the
// rendered brand. Replaces the inherited Griffin's Web Services artwork.
import siteLogo from "@/assets/Logo.jpg";
import defaultOGImage from "@/assets/Logo.jpg";
import { getImageUrl } from "@/utils/images";
import {
  BUSINESS_ID,
  WEBSITE_ID,
  buildBusinessSchema,
  buildPersonSchema,
  buildWebSiteSchema,
  personId,
  founderIds,
} from "@/utils/schema/identity";
import { applySiteMap } from "@/utils/schema/resolve";
import JsonLd from "@/components/Schema/JsonLd.astro";
import type { ImageInput, SEOData } from "@/content/schema";
import { setPageCanonicalUrl } from "@/utils/seo";
import { absoluteWebUrl } from "@/utils/links/linkBehavior";

export interface Props {
  title?: string;              // Page title
  description?: string;        // Page description
  image?: ImageInput;          // Featured image
  author?: string;            // Author name
  authorId?: string;          // `authors` entry id — links the schema author
  publishDate?: Date | string; // Publication date (for articles)
  seo?: SEOData;              // SEO overrides
  siteName?: string;          // Site name override
  robots?: string;            // Shorthand robots directive (e.g. "noindex, nofollow")
  addToLLMs?: boolean;        // Whether this page appears in llms.txt (default: true)
}

const {
  title,
  description,
  image,
  author,
  authorId,
  publishDate,
  seo = {},
  siteName = siteData.title,
  robots,
  addToLLMs,
} = Astro.props;

// Base values from props
const baseTitle = title || "Page";
const baseDescription = description || siteData.description;
const baseImageUrl = getImageUrl(image, defaultOGImage.src);

// Meta tag values (with SEO overrides)
const finalMetaTitle = seo?.metaTitle || `${baseTitle} | ${siteData.title}`;
const finalMetaDescription = seo?.metaDescription || baseDescription;

// Open Graph values (with fallbacks)
const finalOgTitle = seo?.ogTitle || seo?.metaTitle || baseTitle;
const finalOgDescription = seo?.ogDescription || seo?.metaDescription || baseDescription;
const finalOgImageUrl = getImageUrl(seo?.ogImage, baseImageUrl);
const finalOgType = seo?.ogType || "website";

// Twitter Card values (with fallbacks to OG values)
const finalTwitterTitle = seo?.twitterTitle || seo?.ogTitle || finalOgTitle;
const finalTwitterDescription = seo?.twitterDescription || seo?.ogDescription || finalOgDescription;
const finalTwitterImageUrl = getImageUrl(seo?.twitterImage || seo?.ogImage, finalOgImageUrl);
const finalTwitterCard = seo?.twitterCard || "summary_large_image";

// Additional SEO fields
// No placeholder default: an empty list omits the tag entirely.
const finalKeywords: string[] = seo?.keywords || [];
const canonicalPath = Astro.url.pathname === '/' ? '/' : Astro.url.pathname.replace(/\/$/, '');
const finalCanonicalUrl = setPageCanonicalUrl(Astro.locals, Astro.url.pathname, seo);
const effectiveRobots = seo?.robots || robots || "index, follow";

// Author and publisher
const authorName = author || siteData.title;
const publisherName = siteData.legalName || siteData.title;

/**
 * Convert relative URLs to absolute for social sharing
 * Social platforms require absolute URLs for images
 */
const makeAbsolute = (url: string): string => {
  return absoluteWebUrl(url, siteData.url) ?? "";
};

const absoluteOgImage = makeAbsolute(finalOgImageUrl);
const absoluteTwitterImage = makeAbsolute(finalTwitterImageUrl);

// Only the root URL is the WebSite entity; everything else defaults to WebPage.
//
// This previously read `!publishDate ? "WebSite" : "Article"`, which typed
// EVERY undated page as WebSite — so a 30-page site shipped 30 nodes each
// claiming to be the site root. A `publishDate` also means "this content has a
// date", not "this is editorial": legal documents render a "last updated" date
// and were typed as articles because of it.
//
// WebPage is the safe default. Genuinely editorial content opts IN via
// `seo.schemaType` (BlogLayout sets "BlogPosting"), the same override pattern
// as every other seo.* field above.
//
// The homepage is a WebPage too: the WebSite entity is its own node in the
// @graph below (utils/schema/identity.ts), which every page is part of.
const schemaType = seo?.schemaType || "WebPage";

/**
 * Structured data for search engines (JSON-LD)
 * Provides rich snippets in search results
 */
const structuredData: Record<string, any> = {
  "@type": schemaType,
  "name": finalOgTitle,
  "headline": finalOgTitle,
  "description": finalOgDescription,
  "image": absoluteOgImage,
  "url": finalCanonicalUrl,
  "isPartOf": { "@id": WEBSITE_ID },
  // The business, site and people are full nodes in the @graph below; these
  // reference them by @id instead of repeating partial copies.
  "publisher": { "@id": BUSINESS_ID },
  "author": authorId
    ? { "@id": personId(authorId) }
    : publishDate && author
      ? { "@type": "Person", "name": authorName }
      : { "@id": BUSINESS_ID },
  // Article-specific fields
  ...(publishDate && {
    "datePublished": new Date(publishDate).toISOString(),
    "dateModified": new Date(publishDate).toISOString(),
  }),
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": finalCanonicalUrl
  }
};

// Site-wide schema, one @graph: the page, this website, the business behind
// it and its people (the founder, plus the page's author). Breadcrumbs are
// emitted after rendering by SchemaBoundary, using the shared navigation data. The
// page subject (a layout's Service/Course/Product) and section schema (FAQs,
// reviews) are emitted by the components that render them, via <Schema> —
// see utils/schema/README.md.
const people = [
  ...new Set([...await founderIds(), authorId].filter(Boolean) as string[]),
];
const [businessSchema, ...personSchemas] = await Promise.all([
  // `schemaMap.business` (src/utils/schema/siteMap.ts) can add/remove properties.
  buildBusinessSchema({ logoUrl: makeAbsolute(siteLogo.src) }).then((node) =>
    applySiteMap("business", node, { pathname: Astro.url.pathname, locals: Astro.locals as any }),
  ),
  ...people.map((id) => buildPersonSchema(id)),
]);
// An author id with no `authors` entry: fall back rather than reference a
// person node that doesn't exist.
if (authorId && !personSchemas[people.indexOf(authorId)]) {
  structuredData.author = author
    ? { "@type": "Person", "name": authorName }
    : { "@id": BUSINESS_ID };
}

// Combine everything into a single JSON-LD @graph.
const jsonLdGraph = {
  "@context": "https://schema.org",
  "@graph": [
    structuredData,
    buildWebSiteSchema(),
    businessSchema,
    ...personSchemas.filter(Boolean),
  ],
};

// Write per-page manifest entry during static build so the robots-llms
// integration can generate robots.txt and llms.txt without re-deriving URLs.
if (import.meta.env.MODE !== 'development') {
  try {
    const outDir = join(process.cwd(), 'dist', '__seo');
    mkdirSync(outDir, { recursive: true });
    const slug = canonicalPath === '/' ? '_index' : canonicalPath.replace(/^\//, '').replace(/\//g, '__');
    const entry = {
      path: canonicalPath,
      title: finalMetaTitle,
      description: finalMetaDescription,
      robots: effectiveRobots,
      addToLLMs: addToLLMs !== false,
    };
    writeFileSync(join(outDir, `${slug}.json`), JSON.stringify(entry), 'utf8');
  } catch (_) {
    // Non-fatal — manifest write failure should not break the page build
  }
}
---

<!-- Primary Meta Tags -->
<title>{finalMetaTitle}</title>
<meta name="title" content={finalMetaTitle} />
<meta name="description" content={finalMetaDescription} />
<meta name="author" content={authorName} />
<meta name="publisher" content={publisherName} />
{finalKeywords.length > 0 && <meta name="keywords" content={finalKeywords.join(", ")} />}
<link rel="canonical" href={finalCanonicalUrl} />
<meta name="robots" content={effectiveRobots} />

<!-- Open Graph / Facebook / LinkedIn -->
<meta property="og:title" content={finalOgTitle} />
<meta property="og:description" content={finalOgDescription} />
<meta property="og:image" content={absoluteOgImage} />
<meta property="og:type" content={finalOgType} />
<meta property="og:url" content={finalCanonicalUrl} />
<meta property="og:site_name" content={siteName} />
{publishDate && <meta property="article:published_time" content={new Date(publishDate).toISOString()} />}
<meta property="article:author" content={authorName} />
<meta property="article:publisher" content={publisherName} />

<!-- Twitter Card -->
<meta name="twitter:card" content={finalTwitterCard} />
<meta name="twitter:title" content={finalTwitterTitle} />
<meta name="twitter:description" content={finalTwitterDescription} />
<meta name="twitter:image" content={absoluteTwitterImage} />
<meta name="twitter:site" content={publisherName} />
<meta name="twitter:creator" content={authorName} />

<!-- JSON-LD Structured Data -->
<JsonLd schema={jsonLdGraph} />
