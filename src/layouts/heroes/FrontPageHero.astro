---
// src/layouts/heroes/FrontPageHero.astro
import { ctaData } from "@/content/siteData";
import ScrollIndicator from "@/components/ScrollIndicator.astro";
import HeroActions from "@/components/HeroActions.astro";
import HeroQuoteCard from "@/components/HeroQuoteCard.astro";
import ContentRenderer from "@/components/ContentRenderer/ContentRenderer.astro";
import { query, sortByOrder } from "@/utils/query";

export interface Props {
  headline?: string;
  headlineLine2?: string;
  ctaText?: string;
  ctaLink?: string;
  statLabel?: string;
  statValue?: string;
  statDescription?: string;
  bodyText?: string;
  /** Anchor the scroll indicator jumps to. */
  scrollTarget?: string;
  id?: string;
}

const {
  headline = "Built to",
  headlineLine2 = "grow your business.",
  ctaText = ctaData.text ?? "Start a project",
  ctaLink = ctaData.link ?? "/contact-us",
  statLabel = "EST. 2020",
  statValue = "Web design",
  statDescription = "Websites, AI products, and systems built for clarity and growth.",
  bodyText,
  scrollTarget = "#under-hero",
  id = "hero",
} = Astro.props;
---

{/* Mobile: the headline → copy → CTAs → circles block fills the first screen
    on its own (see the top row), and the quote card + stats follow BELOW it, so
    the section is as tall as its content. lg+ stays exactly one viewport, where
    the layout pins its rows top and bottom. */}
<section
  id={id}
  class="relative w-full section-container lg:min-h-svh flex flex-col hero-gap-py"
>

  <!-- Hero body. Mobile: the whole stack is vertically CENTRED (left-aligned
       horizontally) so it reads as a normal, fast hero with no dead space.
       lg+: headline pinned top and the stats/circles/arrow row pinned bottom
       via justify-between — the elegant full-viewport layout. -->
  <div class="relative z-10 flex-1 flex flex-col justify-center lg:justify-between w-full py-0">

    <!-- Top row: headline left, (empty right). On mobile this block flexes to
         fill everything above the scroll arrow and centres its own content, so
         the headline sits optically centred rather than leaving a large gap
         underneath. lg+: back to a natural-height block at the hero's top. -->
    {/* Mobile: exactly one screen tall (100svh less the header clearance the
        section already pads), content centred, with the scroll arrow at its
        foot — so the quote card and stats start below the fold. */}
    <div class="hero-first-screen relative flex flex-1 items-center justify-between gap-8 w-full min-h-[calc(100svh-var(--site-header-height,3.8rem))] pb-20 lg:pb-0 lg:min-h-0 lg:flex-none lg:items-start">

      <!-- Left: headline (+ CTA on desktop). Children spaced by a flex gap
           rather than per-element top margins. -->
      {/* `w-full` on mobile so the column fills the row (no leftover free space
          on the right); `lg:w-auto lg:max-w-3xl` restores the desktop measure. */}
      <div class="w-full lg:w-auto lg:max-w-3xl lg:pt-28 flex flex-col gap-2 text-left">
        {/* Hero headline. heading-display sets the desktop clamp; on mobile we
            override to a smaller size so it doesn't dominate the viewport. */}
        <h1 class="heading-display text-halo text-[2.85rem]! sm:text-[2.75rem]! md:text-[clamp(2.8rem,6.5vw,6rem)]!">
          {headline}<br />{headlineLine2}
        </h1>

        {/* No supporting paragraph here — the hero is the headline alone, and
            that line now lives in the quote card (see the bottom row). */}

        <HeroActions ctaText={ctaText} ctaLink={ctaLink} />

        {/* Mobile only: testimonial circles under the CTAs. */}
        <ContentRenderer
          query={query("testimonials")
            .where((entry) => entry.data.featured === true)
            .limit(3)}
          variant="TestimonialCirclesCounterVariant"
          className="lg:hidden [&_.text-2xl]:text-3xl [&_.support-text]:text-base"
          counterStart={10}
          counterEnd={100}
          counterDuration={1800}
          counterSuffix="+"
          counterLabel="Happy Clients"
        />

      </div>

      {/* Mobile scroll arrow, at the foot of the first screen. The lg+ one
          lives in the bottom row. */}
      <ScrollIndicator href={scrollTarget} className="lg:hidden bottom-6!" />
    </div>

    <!-- Bottom row — pinned to the bottom of the hero by the parent's
         justify-between. Mobile: just the quote card and stats, below the
         first screen (CTAs + circles live up under the headline). lg+:
         [circles] [scroll arrow centred] [quote card + stats]. -->
    <div class="flex flex-col gap-10 mt-auto pb-16 lg:pb-0 lg:mt-0 lg:mb-10 lg:grid lg:grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] lg:items-end w-full">
      <!-- Desktop only: testimonial circles pinned bottom-left. -->
      <ContentRenderer
        query={query("testimonials")
          .where((entry) => entry.data.featured === true)
          .limit(3)}
        variant="TestimonialCirclesCounterVariant"
        className="hidden lg:flex shrink-0 lg:w-[340px]"
        counterStart={10}
        counterEnd={100}
        counterDuration={1800}
        counterSuffix="+"
        counterLabel="Happy Clients"
      />

      <!-- Equal-width outer columns keep the arrow at the hero's true center.
           The row is bottom-aligned (items-end), not centred: the right column
           is taller now that it holds the quote card, and centring lifted the
           circles and arrow up off the bottom edge. -->
      <ScrollIndicator
        href={scrollTarget}
        className="hidden lg:block self-end justify-self-center relative bottom-auto left-auto translate-x-0 static-in-row"
      />

      <!-- Quote card + stats, bottom-right on lg+. Modelled on the Hymanson
           Law hero: the quote card sits directly above the stats. Shown on
           mobile too (above the scroll arrow, which is order-last there), so
           the stats are no longer desktop-only. -->
      <div class="shrink-0 w-full max-w-[30rem] lg:w-[30rem] lg:justify-self-end flex flex-col gap-6 lg:gap-4">
        <HeroQuoteCard body={bodyText || statDescription} />
        {/* Side by side under the card on lg+, as on Hymanson, spread so the
            second stat ends on the card's right edge (the gap is only the
            minimum). nowrap because the column is only just wide enough —
            wrapping stacked them and made the row tall enough to push the hero
            past the viewport. */}
        <ContentRenderer
          query={query("stats").orderBy(sortByOrder())}
          variant="AboutStatsVariant"
          showHeadingSection={false}
          className="lg:flex-nowrap! lg:gap-7! lg:justify-between!"
        />
      </div>
    </div>
  </div>

  <slot />
</section>

<style>
  /* The hero fills the viewport under the fixed header, and its bottom row is
     pinned to the bottom edge with the SAME vertical padding the header uses for
     its own row (py-2), so the top and bottom edges read as symmetrical. */
  .hero-gap-py {
    padding-top: var(--site-header-height, 3.8rem);
    padding-bottom: 0.5rem; /* matches the header's py-2 */
  }
  /* Override ScrollIndicator's default absolute positioning when inline in the row */
  :global(.static-in-row) {
    position: static !important;
    transform: none !important;
    bottom: auto !important;
    left: auto !important;
  }
</style>
