---
// src/layouts/FrontPageHero.astro
// Hero with TextHero layout + Portfolio showcase
import SectionHeading from "@/components/SectionHeading.astro";
import Hero from "@/components/Hero.astro";
import ScrollIndicator from "@/components/ScrollIndicator.astro";
import CheckList from "@/components/CheckList.astro";
import CtaWithProof from "@/components/CtaWithProof.astro";
import { ctaData, siteData } from "@/content/siteData";
import type { HeadingContent } from "@/content/schema";

interface CTA {
  text: string;
  link: string;
  rightIcon?: string;
}

export interface Props {
  heading?: HeadingContent;
  description?: string;
  /** Subheading text shown above the checklist */
  subheading?: string;
  /** Checklist items shown in the hero */
  checklist?: string[];
  primaryCTA?: CTA;
  secondaryCTA?: CTA;
  className?: string;
  id?: string;
  scrollToSection?: string;
}

const defaultDescription =
  "Hand-crafted websites, automated systems, and ongoing support so you can sell more, grow faster, and stay secure without juggling multiple vendors.";

const defaultSubheading = "We're a New Jersey based Web Agency that creates fast, engaging websites built to grow your business.";

const defaultChecklist = [
  "Website Design & Development",
  "Secure Hosting, Maintenance & Support",
  "SEO Ready Architecture",
  "Built for Long-Term Growth",
];

const {
  heading,
  description = siteData.description ?? defaultDescription,
  subheading = defaultSubheading,
  checklist = defaultChecklist,
  primaryCTA: incomingPrimaryCTA,
  secondaryCTA: incomingSecondaryCTA,
  className = "",
  id = "hero",
  scrollToSection,
} = Astro.props as Props;

const primaryCTA: CTA = {
  text: ctaData.text,
  link: ctaData.link,
  ...incomingPrimaryCTA,
  rightIcon: incomingPrimaryCTA?.rightIcon ?? "lu:arrow-up-right",
};

const secondaryCTA: CTA | undefined = incomingSecondaryCTA
  ? {
      ...incomingSecondaryCTA,
      rightIcon: incomingSecondaryCTA.rightIcon ?? "lu:arrow-up-right",
    }
  : undefined;

---

<Hero
  id={id}
  class={`landscape-hero ${className}`}
  size="full"
  contentAlign="center"
  contentVerticalAlign="center"
>
  <div class="relative z-10 inner-section flex flex-wrap items-center h-full">
    <div class="mx-auto px-2 lg:px-0 max-w-6xl lg:max-w-7xl w-full h-full">
      <div class="lg:flex lg:flex-row lg:items-stretch lg:space-x-25 space-y-2 lg:space-y-0 h-full">
        <!-- Left side: Text content -->
        <div class="flex-1 flex flex-col gap-3 lg:gap-6 justify-left hero-content">
          <div class="flex flex-wrap items-end gap-4">
            <SectionHeading
              className="text-left lg:text-left"
              heading={heading}
              headingTag="h1"
              headingClassName="text-3xl sm:text-4xl md:text-5xl lg:text-6xl xl:text-[70px] leading-[1.02]"
            />
          </div>
        </div>

        <!-- Right side: Portfolio showcase -->
        <div
          class="relative flex-1 w-full h-full flex flex-col gap-3 sm:gap-4 hero-portfolio"
        >
          <!-- <div class="flex flex-col gap-4 lg:gap-3"> -->
            <p
              class="m-0 text-base sm:text-xl md:text-2xl xl:text-3xl pr-5 lg:pr-auto"
            >
              {subheading}
            </p>
            <CheckList items={checklist} id={`${id}-hero`} />
          <!-- </div> -->
          <CtaWithProof
            primaryCTA={{ ...primaryCTA, external: true }}
            secondaryCTA={secondaryCTA}
            id="hero-testimonial-circles"
          />
        </div>
      </div>
    </div>
  </div>

<ScrollIndicator slot="after" href={scrollToSection} />
</Hero>
