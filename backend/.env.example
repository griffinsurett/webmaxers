# ==============================================================================
# Webmaxxers AI Blueprint Agent Backend Environment Variables
# ==============================================================================

# Server Configuration
PORT=8000
NODE_ENV=development

# Allowed Frontend Origins (comma-separated for CORS)
CORS_ORIGINS=http://localhost:4321,https://webmaxxers.com

# OpenAI (only LLM provider): chat, analysis, embeddings, web search
# Paste your key after the = sign (no quotes, no spaces). Leave it empty to run without OpenAI.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_ANALYSIS_MODEL=gpt-4.1
OPENAI_BLUEPRINT_MODEL=gpt-4.1
OPENAI_CONTENT_MODEL=gpt-4.1-mini
OPENAI_SEARCH_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Supabase Storage (optional): the admin updates prices and guidance by dropping files into the "knowledge" bucket
# in the Supabase dashboard. Set both (the service key is private: server only, never in the website build).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
KB_BUCKET=knowledge
KB_POLL_SECONDS=60

# Postgres + pgvector knowledge base (local Docker: npm run db:up)
DATABASE_URL=postgres://blueprint:blueprint@localhost:54329/blueprint
# TLS to the database: disable (local Docker) | require | no-verify (hosted databases such as Supabase)
DATABASE_SSL=disable

# Enables admin routes (/api/kb/sync, /api/kb/search). Leave empty to disable them.
ADMIN_TOKEN=

# Rate Limiting & Abuse Prevention
MAX_MESSAGES_PER_SESSION=40
MAX_SESSIONS_PER_IP=5
# Per-second/minute burst throttling (stored in Postgres). Leave on; only "false" disables it.
RATE_LIMIT_ENABLED=true

# Logging: debug | info | warn | error | silent. Logs are JSON lines; visitor text, session ids and keys are never written.
LOG_LEVEL=info

# Number of reverse proxies in front of the API (0 = none) so per-IP limits see the real visitor
TRUST_PROXY=0
