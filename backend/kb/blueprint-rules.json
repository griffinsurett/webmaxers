  "addons": [
    {
      "sku": "addon-managed-forms",
      "priority": 1,
      "recommendWhen": [
        {}
      ],
      "whyYes": "Every website needs reliable delivery of contact and quote requests.",
      "whyNo": "Not needed for this plan."
    },
    {
      "sku": "addon-quote-system",
      "priority": 3,
      "recommendWhen": [
        {
          "goal": [
            "quotes"
          ]
        }
      ],
      "whyYes": "Your main goal is quote requests, so a guided quote form converts better than a plain contact form.",
      "whyNo": "Only needed when quote requests are the main goal."
    },
    {
      "sku": "addon-booking",
      "priority": 2,
      "recommendWhen": [
        {
          "goal": [
            "bookings"
          ]
        },
        {
          "goal": [
            "calls",
            "leads",
            "quotes"
          ],
          "signal": [
            "compBooking"
          ]
        },
        {
          "goal": [
            "calls",
            "leads",
            "quotes"
          ],
          "signal": [
            "compNoBooking"
          ]
        }
      ],
      "skipWhenTool": [
        "booking",
        "calendly",
        "acuity",
        "square appointments"
      ],
      "whyYes": "Lets visitors who prefer not to phone book online, which helps you stand out from local competitors.",
      "whyNo": "Only needed when bookings are a goal or competitors offer online booking."
    },
    {
      "sku": "addon-live-chat",
      "priority": 5,
      "recommendWhen": [
        {
          "signal": [
            "compChat"
          ]
        },
        {
          "goal": [
            "sales"
          ]
        }
      ],
      "whyYes": "Competitors offer live chat, and quick answers help convert visitors who are comparing options.",
      "whyNo": "Not a priority unless competitors offer chat or you sell online."
    },
    {
      "sku": "addon-ai-chat",
      "priority": 4,
      "recommendWhen": [
        {
          "goal": [
            "leads",
            "sales"
          ],
          "industry": [
            "professional-services",
            "b2b-tech",
            "retail"
          ]
        }
      ],
      "whyYes": "Answers visitor questions at any hour and captures leads when no one is available.",
      "whyNo": "Not needed for this type of business right now."
    },
    {
      "sku": "addon-ai-lead-qualification",
      "priority": 7,
      "requires": [
        "addon-ai-chat",
        "addon-live-chat"
      ],
      "recommendWhen": [
        {
          "goal": [
            "leads",
            "quotes"
          ],
          "industry": [
            "professional-services",
            "b2b-tech"
          ]
        }
      ],
      "whyYes": "Sorts serious enquiries from casual ones so your team talks to the right people first.",
      "whyNo": "Needs a chat tool first, and mainly helps lead-heavy businesses."
    },
    {
      "sku": "addon-file-uploads",
      "priority": 8,
      "requires": [
        "addon-managed-forms",
        "addon-quote-system"
      ],
      "recommendWhen": [
        {
          "goal": [
            "quotes"
          ],
          "industry": [
            "home-services"
          ]
        }
      ],
      "whyYes": "Photos of the problem let you quote faster and more accurately.",
      "whyNo": "Only useful when customers need to send photos or documents."
    },
    {
      "sku": "addon-crm",
      "priority": 9,
      "recommendWhen": [
        {
          "tool": [
            "crm",
            "hubspot",
            "salesforce",
            "zoho",
            "pipedrive"
          ]
        }
      ],
      "whyYes": "You already use a CRM, so new enquiries can flow straight into it.",
      "whyNo": "Only relevant if you already use a CRM."
    },
    {
      "sku": "addon-reviews",
      "priority": 6,
      "recommendWhen": [
        {
          "industry": [
            "home-services",
            "restaurant",
            "clinic"
          ]
        },
        {
          "signal": [
            "compReviews"
          ]
        }
      ],
      "whyYes": "Showing real customer reviews builds trust quickly, and competitors already do.",
      "whyNo": "Not a priority for this type of business."
    },
    {
      "sku": "addon-notifications",
      "priority": 10,
      "requires": [
        "addon-managed-forms",
        "addon-quote-system",
        "addon-booking"
      ],
      "recommendWhen": [
        {
          "goal": [
            "calls",
            "quotes",
            "bookings"
          ]
        }
      ],
      "whyYes": "Instant alerts mean new enquiries are never missed, which matters when customers are ready to act.",
      "whyNo": "Needs a form, quote or booking tool to send alerts from."
    },
    {
      "sku": "addon-payments",
      "priority": 11,
      "recommendWhen": [
        {
          "goal": [
            "sales"
          ]
        },
        {
          "industry": [
            "retail"
          ]
        }
      ],
      "whyYes": "You want to sell online, so you need to take payments.",
      "whyNo": "Only needed if you take payments on the website."
    },
