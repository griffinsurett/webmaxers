      "recommendWhen": [
        {
          "goal": [
            "sales",
            "leads"
          ],
          "industry": [
            "retail",
            "restaurant",
            "professional-services"
          ]
        }
      ],
      "whyYes": "Keeps past customers and prospects coming back.",
      "whyNo": "Ongoing email is not a priority for this plan."
    }
