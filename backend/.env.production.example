# Values for docker-compose.prod.yml (or the matching variables in your host's dashboard).
# Copy to .env.production and fill in. Never commit the filled-in copy.

# Database (compose builds DATABASE_URL from these)
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# The origin(s) of the website that calls this API: scheme + host, no path, no trailing slash.
CORS_ORIGINS=https://webmaxxers.com

# How many proxies sit in front of the API (platform router, load balancer). 1 for most hosts.
TRUST_PROXY=1

# Required for the assistant to work. Without it visitors are offered the demo.
OPENAI_API_KEY=

# 24+ random characters. Enables /api/kb/sync and /api/admin/metrics. Leave empty to disable them.
ADMIN_TOKEN=

# Optional: update prices from the Supabase dashboard (see DEPLOY.md section 3b). Both or neither.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional
LOG_LEVEL=info
API_PORT=8000
