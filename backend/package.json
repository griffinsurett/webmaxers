{
  "name": "webmaxxers-blueprint-agent-backend",
  "version": "1.0.0",
  "description": "Backend API and AI orchestration service for the Webmaxxers AI Website Blueprint Builder",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "LOG_LEVEL=silent tsx --test \"src/**/*.test.ts\"",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait",
    "kb:seed": "tsx src/scripts/seed-kb.ts",
    "kb:search": "tsx src/scripts/kb-search.ts",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "openai": "^7.53.0",
    "pg": "^8.23.1",
    "unpdf": "^2.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
