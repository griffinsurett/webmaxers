---
// src/components/BlueprintAgent/BlueprintAgentSection.astro
// The tool's section. No heading and no background of its own: the page supplies
// the hero, and the section stays transparent so the page's backdrop shows through.
import BlueprintAgent from "./BlueprintAgent.tsx";

interface Props {
  id?: string;
  class?: string;
}

const { id = "blueprint-builder", class: className = "" } = Astro.props;
---

<section id={id} class:list={["relative w-full pb-16 lg:pb-24 px-4 sm:px-6 lg:px-8 z-20 isolate", className]}>
  <div class="max-w-7xl mx-auto">
    {/* The Interactive React Island */}
    <BlueprintAgent client:visible />
  </div>
</section>
